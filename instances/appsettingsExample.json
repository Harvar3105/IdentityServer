{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=ExampleIdentity;User Id=example_identity;Password=CHANGE_ME_App!Passw0rd;TrustServerCertificate=true;"
  },
  "Security": {
    "JWTSecret": "CHANGE_ME_at_least_32_random_characters",
    "JWTIssuer": "example-identity",
    "JWTAudience": "example",
    "JWTExpiration": 5,
    "RTExpiration": 7,
    "CredentialRateLimitPermits": 10,
    "CredentialRateLimitWindowSeconds": 60,
    "LockoutMaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15,
    "LockoutAllowedForNewUsers": true,
    "Password": {
      "RequiredLength": 8,
      "RequiredUniqueChars": 0,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false
    },
    "AllowedOrigins": [ "https://example.com" ]
  },
  "ProfilePicture": {
    "MaxSizeBytes": 2097152,
    "MinWidth": 64,
    "MinHeight": 64,
    "MaxWidth": 2048,
    "MaxHeight": 2048,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "AllowedHosts": "*"
}
