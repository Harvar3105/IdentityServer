# Template for instances/.env (git-ignored), read by docker-compose.yml: --env-file instances/.env
# A literal "$" in a value must be written as "$$".

# --- IdentityServer ---
# Host port the server listens on.
AUTH_PORT=8081
# Production reads instances/appsettings.json; Development reads instances/appsettings.Development.json
# and instances/users.json, and enables Swagger.
ASPNETCORE_ENVIRONMENT=Production

# --- SQL Server ---
# Mode: "persistent" keeps databases in a volume; "test" deletes them on "docker compose down".
# Empty: no SQL Server in the stack; the connection strings must point to an external one.
COMPOSE_PROFILES=persistent
# SA (administrator) password, set when the database files are created. Used only to create DB_USER.
MSSQL_SA_PASSWORD=CHANGE_ME_Strong!Passw0rd
# Login the application connects with; created or updated on every "up". Must match "User Id" and
# "Password" in the connection strings of instances/appsettings*.json. Must not contain "'".
DB_USER=example_identity
DB_PASSWORD=CHANGE_ME_App!Passw0rd
# Host port, for local tools and dotnet run (host "localhost,<DB_PORT>").
DB_PORT=1433
# Edition: Express, Developer, Standard, Enterprise or a product key.
DB_EDITION=Express
