# Template for one IdentityServer instance. Copy to instances/<project>.env (git-ignored) and adjust.
# A literal "$" in a value must be written as "$$".

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=example-auth
INSTANCE_ENV_FILE=instances/example.env
ROLES_FILE=./instances/example.roles.json
AUTH_PORT=8081

# --- Application (any appsettings key, "__" separates sections) ---
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=ExampleIdentity;User Id=sa;Password=CHANGE_ME_Strong!Passw0rd;TrustServerCertificate=true;
Security__JWTSecret=CHANGE_ME_at_least_32_random_characters
Security__JWTIssuer=example-identity
Security__JWTAudience=example
Security__AllowedOrigins__0=https://example.com
