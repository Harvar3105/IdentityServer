# Template for one IdentityServer instance. Copy to instances/<project>.env (git-ignored) and adjust.
# A literal "$" in a value must be written as "$$".

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=example-auth
INSTANCE_ENV_FILE=instances/example.env
ROLES_FILE=./instances/example.roles.json
AUTH_PORT=8081

# --- Application ---
# The environment is selected before any JSON configuration is read, so it stays here.
ASPNETCORE_ENVIRONMENT=Production
# TODO: Application settings moved to instances/applicationExample.json, which docker-compose.yml does not
# pass to the container yet; until it does, the instance has no connection string, JWT secret or CORS origins.
